{
  "name": "pi-airline",
  "version": "0.2.3",
  "description": "Claude Code-style status line / HUD for pi: model │ project git:(branch) │ session duration + context usage bar",
  "license": "MIT",
  "author": "Ziy1-Tan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ziy1-Tan/pi-airline.git"
  },
  "homepage": "https://github.com/Ziy1-Tan/pi-airline#readme",
  "bugs": {
    "url": "https://github.com/Ziy1-Tan/pi-airline/issues"
  },
  "type": "module",
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "pi-airline-preview.png"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "airline",
    "hud",
    "statusline",
    "status-line",
    "status bar",
    "footer",
    "claude-code",
    "tui"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-airline.ts"
    ],
    "image": "./pi-airline-preview.png"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
